# Portable handoff: names and examples only. No live values are included.
# Netlify Function runtime. Exact HTTPS origin, without slash.
PUBLIC_ORIGIN=https://your-clinic.example
APP_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Clinime <bookings@your-verified-domain.example>
# Replace with the operator-approved offered schedule before enabling bookings.
CLINIC_SCHEDULE_JSON=
# Prefer explicit staff allowlist. verified-email allows any verified account.
CLINIME_ADMIN_ACCESS=allowlist
CLINIME_ADMIN_EMAILS=
CLINIME_SPECIALISTS_JSON=
CLINIME_ROSTER_SAMPLE=false
# Optional gifts and wallet; absent credentials must not enable success fallbacks.
CLINIME_GIFT_JSON=
CLINIME_WALLET_ENABLED=false
LOOPY_API_KEY=
LOOPY_API_SECRET=
LOOPY_USERNAME=
LOOPY_CAMPAIGN_ID=
LOOPY_VERIFIED_BINDINGS_JSON={}
